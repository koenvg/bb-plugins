{
  "name": "bb-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "bb-plugin-*",
    "packages/*",
    "review-ui"
  ],
  "scripts": {
    "test:setup": "bun test ./scripts/environment-setup.test.mjs ./scripts/pi-compatibility.test.mjs",
    "test:workspaces": "bun test scripts/workspaces.test.mjs",
    "test:browser-lifecycle": "bun test scripts/browser-fixture-runner.test.mjs scripts/browser-preview-servers.test.mjs",
    "test:browser": "bun run --cwd bb-plugin-compose-chat test:browser && bun run --cwd bb-plugin-markdown-reader test:browser && bun run --cwd bb-plugin-codex-quota test:browser && bun run --cwd bb-plugin-pi-subagents-provider test:browser",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "bun --no-install scripts/checks.mjs root",
    "check:review": "bun --no-install scripts/checks.mjs review",
    "test:review": "bun test --timeout 120000 scripts/checks.test.mjs",
    "sdk": "bun --no-install scripts/sdk.mjs",
    "sdk:audit": "bun --no-install scripts/sdk.mjs audit",
    "sdk:align": "bun --no-install scripts/sdk.mjs align",
    "test:sdk": "bun --no-install test --timeout 120000 scripts/sdk.test.mjs"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "bun": "1.4.4"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "ultracite": "8.1.0"
  },
  "patchedDependencies": {
    "tiptap-markdown@0.9.0": "patches/tiptap-markdown@0.9.0.patch",
    "@shikijs/transformers@4.4.3": "patches/@shikijs%2Ftransformers@4.4.3.patch",
    "gaxios@7.3.1": "patches/gaxios@7.3.1.patch",
    "@acemir/cssom@0.9.31": "patches/@acemir%2Fcssom@0.9.31.patch"
  }
}
