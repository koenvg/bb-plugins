{
  "name": "bb-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "bb-plugin-*",
    "packages/*",
    "review-ui"
  ],
  "overrides": {
    "npm": "11.21.0"
  },
  "scripts": {
    "test:setup": "bun test ./scripts/environment-setup.test.mjs ./scripts/pi-compatibility.test.mjs",
    "test:workspaces": "bun test scripts/workspaces.test.mjs",
    "test:browser-lifecycle": "bun test scripts/browser-fixture-runner.test.mjs scripts/browser-preview-servers.test.mjs",
    "test:browser": "bun run --cwd bb-plugin-compose-chat test:browser && bun run --cwd bb-plugin-markdown-reader test:browser && bun run --cwd bb-plugin-codex-quota test:browser && bun run --cwd bb-plugin-pi-subagents-provider test:browser",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "bun --no-install scripts/checks.mjs root",
    "check:review": "bun --no-install scripts/checks.mjs review",
    "test:review": "bun test scripts/checks.test.mjs"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "bun": "1.4.4"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0"
  }
}
