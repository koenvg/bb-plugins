{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": false
  },
  "include": ["*.ts", "*.tsx", "preview/**/*.ts", "preview/**/*.tsx"]
}
