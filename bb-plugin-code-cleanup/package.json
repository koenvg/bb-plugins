{
  "name": "bb-plugin-code-cleanup",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37 <0.7"
  },
  "bb": {
    "name": "Code Cleanup",
    "description": "Project-scoped guidance for substantial cleanup follow-ups.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "lint": "bun run --cwd .. lint bb-plugin-code-cleanup",
    "lint:fix": "bun run --cwd .. lint:fix bb-plugin-code-cleanup",
    "format": "bun run --cwd .. format bb-plugin-code-cleanup",
    "format:check": "bun run --cwd .. format:check bb-plugin-code-cleanup",
    "test": "vitest run",
    "typecheck": "bun --bun tsc --noEmit",
    "preview:settings": "bun preview/server.ts"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.1",
    "hono": "^4.13.9",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "zod": "^4.6.5"
  }
}
