{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "ES2024.Promise", "ESNext.Array", "ESNext.Promise", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["*.ts", "*.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
