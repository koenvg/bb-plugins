{
  "name": "bb-plugin-pi-subagents-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An independent Pi provider fork for BB subagent integration.",
  "engines": {
    "node": ">=24.15.0 <25",
    "bb": ">=0.45.0 <0.46.0",
    "bbPluginSdk": ">=0.6.15 <0.7.0"
  },
  "bb": {
    "name": "Pi with subagents",
    "description": "A separate Pi provider with a read-only Subagents viewer. Installed lifecycle acceptance remains required.",
    "branding": {
      "icon": "./icons/pi.svg"
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions",
    "check:upstream": "node src/upstream/cli.ts",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "@get-bb/plugin-sdk-runtime": "npm:@get-bb/plugin-sdk@0.6.15",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@get-bb/plugin-sdk": "0.6.15",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "bb-app": "0.45.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "5.5.0",
    "hono": "4.13.13",
    "jsdom": "29.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "bb-app": {
      "npm": "11.21.0"
    }
  }
}
