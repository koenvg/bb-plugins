{
  "name": "bb-plugin-markdown-reader",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37 <0.7"
  },
  "bb": {
    "name": "Markdown Reader",
    "description": "A spacious, read-only reader for live workspace, host, and thread-storage Markdown.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": []
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "lint": "bun run --cwd .. lint bb-plugin-markdown-reader",
    "lint:fix": "bun run --cwd .. lint:fix bb-plugin-markdown-reader",
    "format": "bun run --cwd .. format bb-plugin-markdown-reader",
    "format:check": "bun run --cwd .. format:check bb-plugin-markdown-reader",
    "test": "vitest run",
    "test:browser": "bun ../scripts/browser-fixture-runner.mjs tests/preview-server.ts 30000",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bb plugin build",
    "preview:fixture": "bun tests/preview-server.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@bb-plugins/markdown-document": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "bb-app": "0.46.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "hono": "^4.11.9",
    "jsdom": "^28.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
