  "type": "module",
  "license": "MIT",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15 <0.7"
  },
  "bb": {
    "name": "Markdown Reader",
    "description": "A spacious, read-only reader for live workspace, host, and thread-storage Markdown.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": []
  },
  "scripts": {
    "lint": "npm --prefix .. run lint -- bb-plugin-markdown-reader",
    "lint:fix": "npm --prefix .. run lint:fix -- bb-plugin-markdown-reader",
    "format": "npm --prefix .. run format -- bb-plugin-markdown-reader",
    "format:check": "npm --prefix .. run format:check -- bb-plugin-markdown-reader",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "preview:fixture": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "github-slugger": "^2.0.0",
