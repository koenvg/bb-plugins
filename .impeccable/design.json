  "components": [
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Vendored Tasks Plus default variant; host-derived corners and keyboard focus.",
      "html": "<button type=\"button\" class=\"ds-btn-default\">Delegate</button>",
      "css": ".ds-btn-default{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:calc(var(--radius,8px) - 2px);font:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:background-color 150ms,color 150ms;border:none;background:var(--foreground);color:var(--background);}.ds-btn-default:hover{background:color-mix(in oklab,var(--foreground) 90%,transparent);transition-duration:0ms;}.ds-btn-default:focus-visible{outline:none;box-shadow:0 0 0 1px var(--ring);}.ds-btn-default:disabled{pointer-events:none;opacity:.5;}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost-hover",
      "description": "Vendored Tasks Plus ghost variant; host-derived corners and keyboard focus.",
      "html": "<button type=\"button\" class=\"ds-btn-ghost\">Refresh</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:calc(var(--radius,8px) - 2px);font:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:background-color 150ms,color 150ms;border:none;background:transparent;color:var(--foreground);}.ds-btn-ghost:hover{background:var(--state-hover);color:var(--foreground);transition-duration:0ms;}.ds-btn-ghost:focus-visible{outline:none;box-shadow:0 0 0 1px var(--ring);}.ds-btn-ghost:disabled{pointer-events:none;opacity:.5;}.ds-btn-ghost:active,.ds-btn-ghost[aria-pressed=true],.ds-btn-ghost[data-state=open]{background:var(--state-active);}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Vendored Tasks Plus outline variant; host-derived corners and keyboard focus.",
      "html": "<button type=\"button\" class=\"ds-btn-outline\">Cancel</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:calc(var(--radius,8px) - 2px);font:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:background-color 150ms,color 150ms;border:1px solid var(--input);background:transparent;color:var(--foreground);}.ds-btn-outline:hover{background:var(--state-hover);color:var(--foreground);transition-duration:0ms;}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 1px var(--ring);}.ds-btn-outline:disabled{pointer-events:none;opacity:.5;}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Vendored field; grows to 40px on compact coarse-pointer screens.",
      "html": "<input class=\"ds-input\" aria-label=\"Filter tasks\" placeholder=\"Filter tasks\" />",
      "css": ".ds-input{height:36px;padding:4px 12px;border-radius:calc(var(--radius,8px) - 2px);border:1px solid var(--input);background:transparent;color:var(--foreground);font:inherit;font-size:13px;transition:color 150ms,background-color 150ms,border-color 150ms;}.ds-input::placeholder{color:var(--muted-foreground);}.ds-input:hover{transition-duration:0ms;}.ds-input:focus-visible{outline:none;box-shadow:0 0 0 1px var(--ring);}.ds-input:disabled{cursor:not-allowed;opacity:.5;}@media(width < 48rem) and (pointer:coarse){.ds-input{height:40px;font-size:var(--text-base,16px);}}"
    },
    {
      "name": "Neutral Pill",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Non-interactive state or label pill.",
      "html": "<span class=\"ds-pill\">Review required</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;border-radius:9999px;border:1px solid var(--border);padding:2px 8px;font:inherit;font-size:12px;color:var(--muted-foreground);}"
    },
    {
      "name": "Urgent Count",
      "kind": "chip",
      "refersTo": "pill-urgent",
      "description": "Tabular count of items requiring attention.",
      "html": "<span class=\"ds-count\" aria-label=\"3 items need attention\">3</span>",
      "css": ".ds-count{display:inline-flex;border-radius:9999px;background:color-mix(in oklab,var(--destructive) 10%,transparent);color:var(--destructive);padding:0 6px;font:inherit;font-size:11px;font-weight:500;line-height:16px;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Board Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Incumbent Tasks Plus card, including its rest shadow. This shadow is documented drift, not a new-panel default.",
      "html": "<div class=\"ds-card\" role=\"button\" tabindex=\"0\" aria-label=\"Open TASK-12: Fix login\"><div class=\"ds-card-key\">TASK-12</div><div class=\"ds-card-title\">Fix login</div></div>",
      "css": ".ds-card{border-radius:var(--radius,8px);border:1px solid var(--border);background:var(--card);color:var(--foreground);padding:8px 10px;box-shadow:var(--shadow-2xs);cursor:pointer;}.ds-card:hover{border-color:var(--input);}.ds-card:focus-visible{outline:none;box-shadow:0 0 0 2px var(--ring);}.ds-card-key{font-size:10px;color:var(--muted-foreground);font-variant-numeric:tabular-nums;}.ds-card-title{margin-top:4px;font-size:13px;font-weight:500;line-height:1.375;}"
    },
    {
      "name": "Error Banner",
      "kind": "custom",
      "refersTo": "",
      "description": "GitHub Insight inline error and compact retry action; useful data can remain visible.",
      "html": "<div class=\"ds-error\" role=\"alert\"><span>GitHub sign-in required</span><button type=\"button\" class=\"ds-error-retry\">Retry</button></div>",
      "css": ".ds-error{display:flex;align-items:center;gap:8px;border-radius:var(--radius,8px);border:1px solid color-mix(in oklab,var(--destructive) 40%,transparent);background:color-mix(in oklab,var(--destructive) 5%,transparent);padding:8px 12px;font-size:13px;color:var(--destructive);}.ds-error-retry{margin-left:auto;flex-shrink:0;height:24px;padding:0 8px;border-radius:calc(var(--radius,8px) - 2px);border:1px solid var(--border);background:transparent;color:var(--foreground);font:inherit;font-size:12px;cursor:pointer;transition:background-color 150ms;}.ds-error-retry:hover{background:var(--muted);}.ds-error-retry:focus-visible{outline:none;box-shadow:0 0 0 2px color-mix(in oklab,var(--ring) 50%,transparent);}.ds-error-retry:disabled{opacity:.6;}"
    },
    {
      "name": "Threads with PRs Row",
      "kind": "nav",
      "refersTo": "thread-row",
      "description": "Sidebar navigation geometry with a two-line label, PR state, and urgent count. Icons are illustrative.",
      "html": "<a class=\"ds-thread\" href=\"#thread\" aria-current=\"page\"><svg class=\"ds-thread-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M8 4v16M8 7h6a3 3 0 0 1 3 3v7\"/><circle cx=\"8\" cy=\"4\" r=\"2\"/><circle cx=\"8\" cy=\"20\" r=\"2\"/><circle cx=\"17\" cy=\"19\" r=\"2\"/></svg><span class=\"ds-thread-title\">Fix login</span><span class=\"ds-thread-pr\">#42</span><span class=\"ds-thread-meta\">Review required</span><span class=\"ds-thread-count\">3</span></a>",
      "css": ".ds-thread{position:relative;display:grid;grid-template-columns:16px minmax(0,1fr) auto;grid-template-rows:20px 20px;align-content:center;align-items:center;column-gap:8px;min-width:0;height:48px;padding:0 8px;border-radius:var(--radius,8px);color:var(--sidebar-foreground,var(--foreground));text-decoration:none;}.ds-thread[aria-current=page]{background:var(--sidebar-accent);}.ds-thread:hover{background:color-mix(in oklab,var(--sidebar-accent) 60%,transparent);}.ds-thread[aria-current=page]:hover{background:var(--sidebar-accent);}.ds-thread:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--ring);}.ds-thread-icon{grid-column:1;grid-row:1;}.ds-thread-title{grid-column:2;grid-row:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;}.ds-thread-pr{grid-column:3;grid-row:1;font-size:11px;color:var(--primary);font-variant-numeric:tabular-nums;}.ds-thread-meta{grid-column:2;grid-row:2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;color:var(--muted-foreground);}.ds-thread-count{grid-column:3;grid-row:2;border-radius:9999px;padding:0 6px;background:color-mix(in oklab,var(--destructive) 10%,transparent);color:var(--destructive);font-size:11px;font-weight:500;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Compose Chat Frame",
      "kind": "custom",
      "refersTo": "compose-frame",
      "description": "Expanded writing-frame treatment only. Native editor, split-send control, pickers, and footer behavior are not recreated by this preview.",
      "html": "<div class=\"ds-compose\"><textarea class=\"ds-compose-editor\" aria-label=\"Draft\" placeholder=\"Write a follow-up\"></textarea><div class=\"ds-compose-actions\"><button type=\"button\" class=\"ds-compose-send\">Send</button></div></div>",
      "css": ".ds-compose{border:1px solid var(--border-hairline,var(--border));border-radius:calc(var(--radius,8px) + 6px);background:color-mix(in oklab,var(--ink) 2%,var(--canvas));box-shadow:0 4px 16px -6px var(--shadow-color,color-mix(in oklab,var(--ink) 6%,transparent));transition:border-color 150ms ease-out;}.ds-compose-editor{display:block;width:calc(100% - 24px);min-height:72px;margin:12px;border:0;background:transparent;color:var(--foreground);caret-color:var(--foreground);font:inherit;resize:vertical;outline:none;}.ds-compose-editor::placeholder{color:var(--muted-foreground);}.ds-compose-actions{display:flex;justify-content:flex-end;gap:8px;padding:8px 12px;border-top:1px solid var(--border-hairline,var(--border));}.ds-compose-send{min-height:32px;min-width:32px;border:0;border-radius:var(--radius,8px);background:var(--foreground);color:var(--background);padding:0 12px;font:inherit;cursor:pointer;transition:background-color 150ms ease-out,color 150ms ease-out;}.ds-compose-send:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-compose-send:disabled{background:var(--secondary);color:var(--muted-foreground);}@media(hover:hover) and (pointer:fine){.ds-compose-send:hover:not(:disabled){background:color-mix(in oklab,var(--foreground) 90%,var(--background));}}@media(pointer:coarse){.ds-compose-send{min-height:44px;min-width:44px;}}@media(prefers-reduced-motion:reduce){.ds-compose,.ds-compose-send{transition:none;}}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Instrument",
    "overview": "Plugin UI is a grayscale instrument panel that lives inside BB. Ink on canvas does almost all the work. Hierarchy comes from weight, size, and the muted/subtle foreground steps, not from color. Color appears only when it carries state: a check passed, a task is in progress, a PR is blocked. When nothing needs the user, the plugin is quiet.\n\nThe plugins do not own a palette. Use BB's CSS custom properties and host Tailwind utilities for colors, fonts, radii, and floating-layer shadows. The frontmatter retains the recorded BB v0.43.x light-theme snapshot, with Compose Chat's derived surfaces added from current CSS. It is a documentation baseline, not a fresh measurement of BB 0.44 or the active theme. Runtime code references the host token, not the recorded literal. Host themes may supply a chromatic primary; inherit it rather than forcing grayscale.\n\nEach plugin may add a small accent of its own: status marks, count pills, a signature row or card shape, or small motion. These accents sit on top of the native structure and must not replace it. Direction for new controls is calm and roomy: generous padding and comfortable hit areas, inside BB's type scale.",
    "keyCharacteristics": [
      "Grayscale in the baseline theme; plugin-added color carries state.",
      "Host tokens through Tailwind utilities or CSS custom properties.",
      "Flat panels by default; Compose Chat has a scoped soft writing-frame shadow.",
      "Small host sans-serif type, tabular counts, and larger quota-summary type in full panels.",
      "Host SDK icons or the vendored `Icon` component; quota uses a current-color battery SVG."
    ],
    "rules": [],
    "dos": [
      "Do use host tokens through Tailwind utilities or CSS custom properties, including host action colors. Check light, dark, and third-party themes when changing UI; this refresh does not establish a new theme-verification pass.",
      "Do keep plugin-added color for state.",
      "Do use `tabular-nums` on numbers that update.",
      "Do use `state-hover` and `state-active` for new interaction feedback.",
      "Do truncate narrow status labels and let reading text and errors wrap.",
      "Do use the host registry or SDK primitives where available, and preserve native compound-control geometry.",
      "Do keep Compose Chat's derived surfaces, radii, and soft shadow scoped to its writing frame and messages."
    ],
    "donts": [
      "Don't hard-code the recorded palette or shadow snapshot into runtime UI. A status without a host token may use a documented light/dark pair.",
      "Don't use a raw Tailwind hue when BB has a token for that state.",
      "Don't put a rest shadow on a new ordinary panel surface; Compose Chat's writing frame is the documented exception.",
      "Don't add a plugin brand color, logo mark, or custom font. Keep provider and project identities intact.",
      "Don't copy the quota dashboard's large summary type into narrow slots.",
      "Don't treat a recorded light-theme sample or a synthetic acceptance measurement as proof of contrast in every host theme."
    ]
  }
