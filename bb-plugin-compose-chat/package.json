{
  "name": "bb-plugin-compose-chat",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "lint": "npm --prefix .. run lint -- bb-plugin-compose-chat",
    "lint:fix": "npm --prefix .. run lint:fix -- bb-plugin-compose-chat",
    "format": "npm --prefix .. run format -- bb-plugin-compose-chat",
    "format:check": "npm --prefix .. run format:check -- bb-plugin-compose-chat",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "bash tests/browser-checks.sh",
    "build": "bb plugin build ."
  },
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15 <0.7"
  },
  "bb": {
    "name": "Compose Chat",
    "description": "A Compose-inspired restyle of BB's native chat, using the active theme and preserving its controls.",
    "branding": {
      "icon": "MessageCircle"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "dependencies": {},
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  }
}
