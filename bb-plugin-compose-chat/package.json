{
  "name": "bb-plugin-compose-chat",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "lint": "bun run --cwd .. lint bb-plugin-compose-chat",
    "lint:fix": "bun run --cwd .. lint:fix bb-plugin-compose-chat",
    "format": "bun run --cwd .. format bb-plugin-compose-chat",
    "format:check": "bun run --cwd .. format:check bb-plugin-compose-chat",
    "test": "vitest run",
    "typecheck": "bun --bun tsc --noEmit",
    "test:browser": "bun ../scripts/browser-fixture-runner.mjs tests/preview-server.ts 30000",
    "build": "bb plugin build ."
  },
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37 <0.7"
  },
  "bb": {
    "name": "Compose Chat",
    "description": "A Compose-inspired restyle of BB's native chat, using the active theme and preserving its controls.",
    "branding": {
      "icon": "MessageCircle"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "esbuild": "0.28.2",
    "hono": "^4.11.9",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  }
}
