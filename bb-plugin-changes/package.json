{
  "name": "bb-plugin-changes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "lint": "bun run --cwd .. lint bb-plugin-changes",
    "lint:fix": "bun run --cwd .. lint:fix bb-plugin-changes",
    "format": "bun run --cwd .. format bb-plugin-changes",
    "format:check": "bun run --cwd .. format:check bb-plugin-changes",
    "test": "vitest run",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37 <0.7"
  },
  "bb": {
    "name": "Changes",
    "description": "Shows the diff of a thread in a Changes tab, with inline review comments that you send to the agent in one message.",
    "branding": {
      "icon": "EditFile"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-dialog": "^1.1.19",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "hono": "^4.11.9",
    "jsdom": "^30.1.1",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
